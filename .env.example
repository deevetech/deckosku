# --- DECKO Size Management — environment file ---
# Copy this file to `.env` and fill in real values for your install.
# Never commit `.env` to git. Only `.env.example` is tracked.

# Application
APP_NAME="DECKO Size Management"
APP_ENV=local                       # local | staging | production
APP_DEBUG=true                      # set false in production
APP_URL=http://localhost/decko/size-management/public
APP_TIMEZONE=Asia/Brunei

# Security — generate a long random string for production
APP_KEY=please-change-me-to-a-long-random-string

# Database — pick one driver
#   DB_DRIVER=sqlite  (default, recommended for small catalogues; zero ops)
#   DB_DRIVER=mysql   (use this if hosting on a server with phpMyAdmin/MySQL)
DB_DRIVER=sqlite

# --- SQLite (only used when DB_DRIVER=sqlite) ---
DB_PATH=storage/database.sqlite

# --- MySQL (only used when DB_DRIVER=mysql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=decko_size
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Excel source file
EXCEL_PATH="DECKO Warehouse SKU and Barcode list.xlsx"
EXCEL_SHEET="New Warehouse"
EXCEL_HEADER_ROW=2                  # row number where column headers live (1-indexed)
EXCEL_DATA_STARTS=3                 # row number where data rows start (1-indexed)

# Session
SESSION_NAME=decko_size_session
SESSION_LIFETIME_MINUTES=480        # 8 hours
SESSION_SECURE=false                # set true when serving over HTTPS
SESSION_SAMESITE=Lax

# Default admin (only used by `php bin/seed.php` for first-time setup)
ADMIN_EMAIL=admin@decko.local
ADMIN_PASSWORD=ChangeMe-on-first-login!
